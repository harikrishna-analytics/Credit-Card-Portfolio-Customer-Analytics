      </column>
      <column caption='SUM(if LOWER([Contactless])=&apos;yes&apos; THEN 1 ELSE 0 END)' datatype='integer' name='[Calculation_1543197290385430]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if LOWER([Contactless])=&apos;yes&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Physical Cards' datatype='integer' name='[Calculation_1543197292523543]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF ([Card_Mode]) =&apos;physical&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Inactive Cards' datatype='integer' name='[Calculation_1543197293957144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF LOWER([Card_Status]) &lt;&gt; &apos;active&apos;  THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Inactive  Exposure' datatype='integer' name='[Calculation_1543197294436377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if LOWER([Card_Status]) &lt;&gt; &apos;active&apos; THEN [Credit_Limit] ELSE 0 END)' />
      </column>
      <column caption='Active Exposure' datatype='integer' name='[Calculation_1543197294878746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF LOWER([Card_Status])=&apos;active&apos; THEN [Credit_Limit] ELSE 0 END)' />
