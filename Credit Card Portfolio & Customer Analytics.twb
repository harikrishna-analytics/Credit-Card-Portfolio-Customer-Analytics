      <column caption='ActiveCards' datatype='integer' name='[Calculation_1543197237043200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if LOWER([Card_Status])=&apos;active&apos; then 1 else 0 end)' />
      </column>
      <column caption='Active Card %' datatype='real' name='[Calculation_1543197238382593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1543197237043200]/COUNTD([Card_ID])' />
      </column>
      <column caption='Contactless Cards' datatype='integer' name='[Calculation_1543197238788098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if LOWER([Contactless]) =&apos;yes&apos; THEN  1 ELSE 0 end)' />
      </column>
      <column caption='Contactless Adoption %' datatype='real' name='[Calculation_1543197239439363]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1543197238788098]/COUNTD([Card_ID])' />
      </column>
      <column caption='Cards Per Customer' datatype='integer' name='[Calculation_1543197249429509]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Customer_ID]: COUNTD([Card_ID]) }' />
      </column>
      <column caption='Customer Exposure' datatype='integer' name='[Calculation_1543197249732614]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Customer_ID]: SUM([Credit_Limit]) }' />
      </column>
      <column caption='Card Exposure' datatype='real' name='[Calculation_1543197280993289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Credit_Limit])/COUNT([Card_ID])' />
      </column>
      <column caption='Virtual Cards' datatype='integer' name='[Calculation_1543197285613580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if LOWER([Card_Mode])= &apos;virtual&apos; THEN 1 ELSE 0 end)' />
      </column>
      <column caption='Virutal Adoptation %' datatype='real' name='[Calculation_1543197285998605]' role='measure' type='quantitative'>
